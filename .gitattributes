# Line endings matter here: the .sh files are pushed to an Android device and
# executed by /system/bin/sh, which chokes on CR.  The .bat files need CRLF.
* text=auto

*.sh   text eol=lf
*.ps1  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.bat  text eol=crlf

# Shell scripts that get run by the kernel / init without a matching extension.
device/mp_p1  text eol=lf
# Helper scripts installed into the chroot's /usr/local/bin by payload section 5e.
# They have no extension, so without this rule core.autocrlf=true checks them out
# as CRLF and /bin/sh refuses the shebang on a fresh clone.
device/phone-tools/*  text eol=lf
# Python tool pushed into the chroot and executed via its shebang.
device/n2wifi  text eol=lf

# Never touch these.
*.gz   -text
*.tar  -text
*.apk  -text
*.exe  -text
*.dll  -text
*.img  -text
*.elf  -text
device/n2/*       -text
exploit/note2-root -text
