# A chroot has its own "/" so Android paths are only reachable through
# /proc/1/root.  From an Android root shell /proc/1/root IS "/", so trying both
# covers every setup.
ANDROID_ROOT = "/proc/1/root"

CANDIDATES = [
    # Android 7 - 10
    "/data/misc/wifi/WifiConfigStore.xml",
    # Android 11+ (Wi-Fi module moved into an APEX)
    "/data/misc/apexdata/com.android.wifi/WifiConfigStore.xml",
]

UID, GID = 1000, 1000  # Android system


def resolve_store():
    override = os.environ.get("N2WIFI_XML")
    if override:
        return override
    for p in CANDIDATES:
        for cand in (p, ANDROID_ROOT + p):
            if os.path.exists(cand):
                return cand
    return ANDROID_ROOT + CANDIDATES[0]


XML = resolve_store()

