def cmd_list():
    nets = parse_networks(read_text())
    if not nets:
        print(t("no_saved"))
        return
    cur = current_connection().get("ssid")
    print(t("saved_list", n=len(nets)))
    for ssid, _ in nets:
        mark = t("cur_mark") if cur and ssid == cur else ""
        print("  " + ssid + mark)


def cmd_status():
    nets = parse_networks(read_text())
    info = current_connection()
    print(t("status_ssid", v=info.get("ssid", t("not_connected"))))
    print(t("status_signal", v=info.get("signal", "-")))
    print(t("status_band", v=info.get("freq", "-")))
    print(t("status_ip", v=info.get("ip", "-")))
    print(t("status_saved", n=len(nets), list=", ".join(s for s, _ in nets)))


def cmd_ip():
    ip = current_connection().get("ip")
    if not ip:
        die(t("not_connected"), 2)
    print(ip.split("/")[0])


def iw_scan():
    err = ""
    for _ in range(3):
        try:
            p = subprocess.run(iw_cmd(["dev", "wlan0", "scan"]),
                               capture_output=True, text=True, timeout=45)
        except subprocess.TimeoutExpired:
            err = t("scan_timeout")
            break
        if p.returncode == 0 and "BSS " in p.stdout:
            return p.stdout
        err = (p.stderr or p.stdout).strip() or ("exit %d" % p.returncode)
        if "busy" not in err.lower():
            break
        time.sleep(2)
    die(t("scan_fail", err=err))


def parse_scan(text):
    out = []
    cur = None
    for line in text.splitlines():
        if line.startswith("BSS "):
            if cur:
                out.append(cur)
            m = re.match(r"BSS ([0-9a-fA-F:]{17})", line)
            cur = {"bssid": m.group(1) if m else "?", "freq": "", "signal": None,
                   "ssid": "", "privacy": False, "rsn": False, "wpa": False,
                   "associated": "associated" in line}
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("freq:"):
            cur["freq"] = s.split(":", 1)[1].strip()
        elif s.startswith("signal:"):
            m = re.search(r"(-?\d+(?:\.\d+)?)", s)
            if m:
                cur["signal"] = float(m.group(1))
        elif s.startswith("SSID:"):
            cur["ssid"] = s.split(":", 1)[1].strip()
        elif s.startswith("capability:"):
            cur["privacy"] = "Privacy" in s
        elif s.startswith("RSN:"):
            cur["rsn"] = True
        elif s.startswith("WPA:"):
            cur["wpa"] = True
    if cur:
        out.append(cur)
    return out


def cmd_scan(show_all=False):
    aps = parse_scan(iw_scan())
    if not aps:
        print(t("scan_none"))
        return
    cur = current_connection().get("ssid")
    saved = set(s for s, _ in parse_networks(read_text()))
    if show_all:
        rows = sorted(aps, key=lambda b: (b["signal"] is None, -(b["signal"] or -200)))
    else:
        best = {}
        for b in aps:
            k = b["ssid"] or t("hidden")
            if k not in best or (b["signal"] or -200) > (best[k]["signal"] or -200):
                best[k] = b
        rows = sorted(best.values(), key=lambda b: -(b["signal"] or -200))
    print(t("scan_head", aps=len(aps), ssids=len(rows)))
    hdr = (pad(t("col_signal"), 10) + pad(t("col_band"), 6)
           + pad(t("col_chan"), 6) + pad(t("col_sec"), 12))
    if show_all:
        hdr += pad(t("col_bssid"), 19)
    print("  " + hdr + t("col_ssid"))
    for b in rows:
        name = b["ssid"] or t("hidden")
        sig = ("%d dBm" % round(b["signal"])) if b["signal"] is not None else "-"
        tags = []
        if name == cur:
            tags.append(t("tag_current"))
        elif name in saved:
            tags.append(t("tag_saved"))
        if b["associated"]:
            tags.append(t("tag_assoc"))
        tail = ("   [" + ",".join(tags) + "]") if tags else ""
        line = ("  " + pad(sig, 10) + pad(band_of(b["freq"]), 6)
                + pad(chan_of(b["freq"]), 6) + pad(security_of(b), 12))
        if show_all:
            line += pad(b["bssid"], 19)
        print(line + name + tail)
    if not show_all:
        print("")
        print(t("scan_hint"))


