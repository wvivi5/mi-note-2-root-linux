# commands: add / del / apply / backups / revert
# --------------------------------------------------------------------------

def _set_str(blk, name, value_xml):
    pat = re.compile(r'(<string name="%s">).*?(</string>)' % re.escape(name), re.S)
    if pat.search(blk):
        return pat.sub(lambda m: m.group(1) + value_xml + m.group(2), blk, count=1)
    return blk


def _set_int(blk, name, value):
    pat = re.compile(r'<int name="%s" value="[^"]*" />' % re.escape(name))
    if pat.search(blk):
        return pat.sub('<int name="%s" value="%s" />' % (name, value), blk, count=1)
    return blk


def _set_bool(blk, name, value):
    pat = re.compile(r'<boolean name="%s" value="[^"]*" />' % re.escape(name))
    if pat.search(blk):
        return pat.sub('<boolean name="%s" value="%s" />' % (name, "true" if value else "false"),
                       blk, count=1)
    return blk


def _set_psk(blk, psk):
    """write <string name="PreSharedKey"> (psk=None means an open network)"""
    blk = re.sub(r'<string name="PreSharedKey">.*?</string>', "", blk, count=1, flags=re.S)
    blk = re.sub(r'<null name="PreSharedKey" />', "", blk, count=1)
    new = ('<null name="PreSharedKey" />' if psk is None
           else '<string name="PreSharedKey">&quot;%s&quot;</string>' % xml_escape(psk))
    m = re.search(r'<string name="SSID">.*?</string>', blk, re.S)
    if not m:
        return blk.replace("<WifiConfiguration>",
                           "<WifiConfiguration>\n" + new, 1)
    return blk[:m.end()] + "\n" + new + blk[m.end():]


def _set_bytearray(blk, name, hexval):
    pat = re.compile(r'(<byte-array name="%s" num="1">).*?(</byte-array>)' % re.escape(name), re.S)
    return pat.sub(lambda m: m.group(1) + hexval + m.group(2), blk, count=1)


def make_block(text, ssid, psk=None, open_net=False):
    """Clone an existing <Network> block and rewrite the fields that matter.

    Why clone instead of writing one from scratch: Android's parser is picky and
    silently drops blocks with missing fields (measured: without CreationTime the
    network disappears on the next framework restart).  Cloning guarantees the
    exact format the system writes itself.
    """
    nets = parse_networks(text)
    blk = nets[-1][1] if nets else TEMPLATE
    ssid_x = "&quot;" + xml_escape(ssid) + "&quot;"
    if open_net:
        blk = _set_bytearray(blk, "AllowedKeyMgmt", "01")
        blk = _set_bytearray(blk, "AllowedProtocols", "01")
        blk = _set_psk(blk, None)
        config_key = ssid_x + "-NONE"
    else:
        blk = _set_bytearray(blk, "AllowedKeyMgmt", "02")
        blk = _set_bytearray(blk, "AllowedProtocols", "0b")
        blk = _set_psk(blk, psk)
        config_key = ssid_x + "-WPA_PSK"
    blk = _set_str(blk, "ConfigKey", config_key)
    blk = _set_str(blk, "SSID", ssid_x)
    blk = _set_int(blk, "NumAssociation", 0)
    blk = _set_int(blk, "Status", 2)
    blk = _set_int(blk, "LastConnectUid", 0)
    blk = _set_bool(blk, "HasEverConnected", False)
    blk = _set_bool(blk, "ValidatedInternetAccess", False)
    blk = _set_bool(blk, "HiddenSSID", False)
    return blk


def insert_block(text, block):
    j = text.find("</NetworkList>")
    if j < 0:
        die("WifiConfigStore.xml has no </NetworkList>")
    return text[:j] + block + "\n" + text[j:]


def cmd_add(ssid, psk=None, open_net=False, remind=True):
    if not ssid:
        die(t("ssid_empty"))
    if not open_net:
        if not psk:
            die(t("need_psk"))
        if not (8 <= len(psk) <= 63):
            die(t("psk_len"))
    text = read_text()
    existing = [s for s, _ in parse_networks(text)]
    if ssid in existing:
        die(t("already", ssid=ssid))
    b = backup()
    new_text = insert_block(text, make_block(text, ssid, psk, open_net))
    write_atomic(new_text)
    after = parse_networks(read_text())
    if ssid not in [s for s, _ in after] or len(after) != len(existing) + 1:
        die(t("write_verify_fail", b=b))
    print(t("added", ssid=ssid, old=len(existing), new=len(after)))
    print(t("backup_line", b=b))
    if remind:
        print(t("add_only_note"))


def cmd_del(ssid):
    text = read_text()
    nets = parse_networks(text)
    if not any(s == ssid for s, _ in nets):
        die(t("no_such_ssid", ssid=ssid))
    b = backup()
    new_text = text
    for s, blk in nets:
        if s == ssid:
            new_text = new_text.replace(blk, "")
            break
    write_atomic(new_text)
    after = [s for s, _ in parse_networks(read_text())]
    if ssid in after or len(after) != len(nets) - 1:
        die(t("del_verify_fail", b=b))
    print(t("deleted", ssid=ssid, n=len(after)))
    print(t("backup_line", b=b))
    print(t("apply_note"))


def find_pid(name):
    """find a process by cmdline, without depending on pgrep"""
    for d in glob.glob("/proc/[0-9]*"):
        try:
            with open(d + "/cmdline", "rb") as f:
                raw = f.read()
        except (OSError, IOError):
            continue
        if not raw:
            continue
        cmd = raw.replace(b"\0", b" ").decode("utf-8", "replace").strip()
        if cmd == name or cmd.startswith(name + " "):
            return int(os.path.basename(d))
    return None


def cmd_apply():
    """Make Android reload the Wi-Fi config.

    Killing system_server makes zygote exit and init start a fresh system_server,
    which re-reads WifiConfigStore.xml.  netd and wpa_supplicant are untouched,
    so the link (and our ssh session) normally stays alive.
    """
    pid = find_pid("system_server")
    if not pid:
        die(t("apply_no_ss"))
    print(t("apply_start", pid=pid))
    print(t("apply_hint1"))
    print(t("apply_hint2"))
    try:
        os.kill(pid, 9)
    except OSError as e:
        die(t("apply_kill_fail", e=e))
    t0 = time.time()
    newpid = None
    while time.time() - t0 < 180:
        time.sleep(2)
        p = find_pid("system_server")
        if p and p != pid:
            newpid = p
            break
    if newpid:
        print(t("apply_back", pid=newpid, sec=int(time.time() - t0)))
    else:
        print(t("apply_late"))
    # wait for the station to reassociate
    t1 = time.time()
    while time.time() - t1 < 90:
        time.sleep(3)
        if current_connection().get("ssid"):
            break
    time.sleep(2)
    cmd_status()


def cmd_backups():
    found = sorted(glob.glob(XML + ".n2bak-*"))
    if not found:
        print(t("no_backups"))
        return
    for f in found:
        print("%s  (%s)" % (f, time.strftime("%Y-%m-%d %H:%M:%S",
                                             time.localtime(os.path.getmtime(f)))))


def cmd_revert(path=None):
    if not path:
        cands = sorted(glob.glob(XML + ".n2bak-*"))
        if not cands:
            die(t("no_backups"))
        path = cands[-1]
    if not os.path.exists(path):
        die(t("no_such_backup", p=path))
    with open(path, "r", encoding="utf-8") as f:
        chk = f.read()
    if "<NetworkList>" not in chk:
        die(t("bad_backup"))
    shutil.copy2(path, XML)
    try:
        os.chmod(XML, 0o600)
        os.chown(XML, UID, GID)
    except OSError:
        pass
    print(t("reverted", p=path))
    print(t("apply_note"))


def cmd_join(ssid, psk=None, open_net=False):
    cmd_add(ssid, psk, open_net, remind=False)
    cmd_apply()


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main():
    global LANG
    a = sys.argv[1:]

    # --lang can appear anywhere
    if "--lang" in a:
        i = a.index("--lang")
        val = a[i + 1] if i + 1 < len(a) else ""
        if val not in ("en", "zh"):
            die("--lang expects 'en' or 'zh'")
        LANG = val
        del a[i:i + 2]

    if not a or a[0] in ("-h", "--help", "help"):
        print(usage())
        return
    if a[0] in ("-V", "--version", "version"):
        print("n2wifi " + VERSION)
        return

    if os.geteuid() != 0:
        die(t("not_root"))

    cmd = a[0]
    if cmd == "list":
        cmd_list()
    elif cmd == "status":
        cmd_status()
    elif cmd == "ip":
        cmd_ip()
    elif cmd == "scan":
        cmd_scan("--all" in a)
    elif cmd in ("add", "join"):
        if len(a) < 2:
            die(t("usage_add") if cmd == "add" else t("usage_join"))
        open_net = "--open" in a
        psk = None if open_net else (a[2] if len(a) > 2 else None)
        if cmd == "add":
            cmd_add(a[1], psk, open_net)
        else:
            cmd_join(a[1], psk, open_net)
    elif cmd == "del":
        if len(a) < 2:
            die(t("usage_del"))
        cmd_del(a[1])
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "backups":
        cmd_backups()
    elif cmd == "revert":
        cmd_revert(a[1] if len(a) > 1 else None)
    else:
        die(t("unknown_cmd", cmd=cmd, usage=usage()))


if __name__ == "__main__":
    main()
