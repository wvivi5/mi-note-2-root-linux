def _lang_from_env():
    for k in ("N2WIFI_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        v = (os.environ.get(k) or "").strip().lower()
        if v.startswith("zh"):
            return "zh"
        if v.startswith("en"):
            return "en"
    return "en"


LANG = _lang_from_env()


def t(key, **kw):
    s = M.get(LANG, {}).get(key)
    if s is None:
        s = M["en"].get(key, key)
    return s.format(**kw) if kw else s


def usage():
    return t("usage").format(version=VERSION)


