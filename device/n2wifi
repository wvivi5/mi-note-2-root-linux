def die(msg, code=1):
    print("error: " + msg, file=sys.stderr)
    sys.exit(code)


def xml_escape(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;")
             .replace(">", "&gt;").replace('"', "&quot;"))


def read_text():
    if not os.path.exists(XML):
        die(t("store_missing", paths="\n             ".join(
            [XML] + [ANDROID_ROOT + p for p in CANDIDATES])))
    with open(XML, "r", encoding="utf-8", errors="replace") as f:
        return f.read()


def decode_ssid(raw):
    """<SSID> may be &quot;name&quot; or a hex blob."""
    s = (raw.replace("&quot;", '"').replace("&amp;", "&")
            .replace("&lt;", "<").replace("&gt;", ">")).strip()
    if re.fullmatch(r"([0-9a-fA-F]{2})+", s):
        try:
            return bytes.fromhex(s).decode("utf-8", "replace")
        except Exception:
            return s
    if len(s) >= 2 and s[0] == '"' and s[-1] == '"':
        s = s[1:-1]
    return s


def parse_networks(text):
    """[(ssid, block)] for everything inside <NetworkList>"""
    i = text.find("<NetworkList>")
    j = text.find("</NetworkList>")
    if i < 0 or j < 0:
        return []
    body = text[i:j]
    out = []
    for m in NET_RE.finditer(body):
        blk = m.group(0)
        s = SSID_RE.search(blk)
        out.append((decode_ssid(s.group(1)) if s else "", blk))
    return out


def iw_cmd(args):
    """Pick whichever iw is available: PATH, then the Android one."""
    if shutil.which("iw"):
        return ["iw"] + args
    for cand in (ANDROID_ROOT + "/system/bin/iw", "/system/bin/iw"):
        if os.path.exists(cand):
            if cand.startswith(ANDROID_ROOT):
                return ["chroot", ANDROID_ROOT, "/system/bin/iw"] + args
            return [cand] + args
    die(t("no_iw"))


def current_connection():
    info = {}
    try:
        out = subprocess.run(iw_cmd(["dev", "wlan0", "link"]),
                             capture_output=True, text=True, timeout=15).stdout
        m = re.search(r"SSID:\s*(.+)", out)
        if m:
            info["ssid"] = m.group(1).strip()
        m = re.search(r"signal:\s*(.+)", out)
        if m:
            info["signal"] = m.group(1).strip()
        m = re.search(r"freq:\s*(\d+)", out)
        if m:
            info["freq"] = m.group(1) + " MHz"
    except Exception:
        pass
    try:
        out = subprocess.run(["ip", "-4", "addr", "show", "wlan0"],
                             capture_output=True, text=True, timeout=10).stdout
        m = re.search(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", out)
        if m:
            info["ip"] = m.group(1)
    except Exception:
        pass
    return info


def dw(s):
    """terminal display width (CJK = 2 cells)"""
    w = 0
    for ch in str(s):
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def pad(s, width):
    s = str(s)
    return s + " " * max(0, width - dw(s))


def chan_of(freq):
    try:
        f = int(freq)
    except Exception:
        return "?"
    if f == 2484:
        return "14"
    if 2412 <= f <= 2472:
        return str((f - 2407) // 5)
    if 5000 < f < 5925:
        return str((f - 5000) // 5)
    return "?"


def band_of(freq):
    try:
        f = int(freq)
    except Exception:
        return "?"
    if 2400 <= f < 2500:
        return "2.4G"
    if 4900 < f < 5925:
        return "5G"
    return str(f) + "M"


def security_of(b):
    if b["rsn"] and b["wpa"]:
        return "WPA/WPA2"
    if b["rsn"]:
        return "WPA2/WPA3"
    if b["wpa"]:
        return "WPA"
    if b["privacy"]:
        return "WEP"
    return t("sec_open")


def backup():
    ts = time.strftime("%Y%m%d-%H%M%S")
    dst = XML + ".n2bak-" + ts
    # two writes inside the same second must not clobber each other
    n = 2
    while os.path.exists(dst):
        dst = XML + ".n2bak-" + ts + "-%d" % n
        n += 1
    shutil.copy2(XML, dst)
    try:
        os.chmod(dst, 0o600)
        os.chown(dst, UID, GID)
    except OSError:
        pass
    return dst


def write_atomic(new_text):
    tmp = XML + ".n2tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(new_text)
    os.chmod(tmp, 0o600)
    try:
        os.chown(tmp, UID, GID)
    except OSError:
        pass
    # self-check: must still be valid XML with the expected structure
    try:
        import xml.etree.ElementTree as ET
        root = ET.parse(tmp).getroot()
        if root.tag != "WifiConfigStoreData":
            raise ValueError("root tag = " + root.tag)
        if not root.find("NetworkList"):
            raise ValueError("no NetworkList")
    except Exception as e:
        os.unlink(tmp)
        die(t("selfcheck_fail", e=e))
    os.replace(tmp, XML)


